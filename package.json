{
  "name": "atlas-local-desktop",
  "version": "0.6.7",
  "private": true,
  "description": "Local desktop interface for Codex and Claude Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "build:syntax": "node build/bundle-syntax.cjs",
    "prestart": "npm run build:syntax",
    "pretest": "npm run build:syntax",
    "predist:win": "npm run build:syntax",
    "test:colab-ui": "electron tests/colab-history.browser.cjs",
    "test:assistant-ui": "electron tests/assistant-chat.browser.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "diff": "9.0.0",
    "electron-updater": "6.8.9",
    "kokoro-js": "1.2.1",
    "prismjs": "1.30.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true
  },
  "productName": "ATLAS",
  "build": {
    "appId": "com.springycape.atlas",
    "productName": "ATLAS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!README.md",
      "!Setup-ATLAS.ps1",
      "!Start-ATLAS.cmd",
      "!install-desktop-runtime.cmd",
      "!build/**",
      "!dist/**",
      "!speech/**"
    ],
    "extraResources": [
      {
        "from": "speech/whisper/Release",
        "to": "speech/whisper/Release",
        "filter": [
          "whisper-server.exe",
          "*.dll"
        ]
      },
      {
        "from": "speech/models",
        "to": "speech/models",
        "filter": [
          "ggml-tiny.en.bin",
          "ggml-small.en-q5_1.bin"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ATLAS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ATLAS",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "springycape20",
        "repo": "atlas-desktop",
        "releaseType": "release"
      }
    ]
  }
}
