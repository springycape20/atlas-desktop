{
  "name": "atlas-local-desktop",
  "version": "0.10.4",
  "private": true,
  "description": "Local desktop interface for Codex and Claude Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "build:syntax": "node build/bundle-syntax.cjs",
    "prestart": "npm run build:syntax",
    "pretest": "npm run build:syntax",
    "predist:win": "npm run build:syntax",
    "test:colab-ui": "electron tests/colab-history.browser.cjs",
    "test:graph-ui": "electron tests/colab-graph.browser.cjs",
    "test:approvals-ui": "electron tests/approvals.browser.cjs",
    "test:assistant-ui": "electron tests/assistant-chat.browser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:dispute-ui": "electron tests/colab-dispute.browser.cjs",
    "test:settings-ui": "electron tests/settings.browser.cjs",
    "test:power-ui": "electron tests/power-tools.browser.cjs",
    "test:navigation-ui": "electron tests/ui-navigation.browser.cjs",
    "test:files-ui": "electron tests/project-files.browser.cjs",
    "test:pty-ui": "electron tests/pty.browser.cjs",
    "test:pty-render-ui": "electron tests/pty-render.browser.cjs",
    "test:pdf-package-ui": "electron tests/pdf-package.browser.cjs",
    "test:restore-ui": "electron tests/restore.browser.cjs",
    "test:preview-ui": "electron tests/live-preview.browser.cjs",
    "test:release-ui": "electron tests/release-screens.browser.cjs",
    "test:menu-ui": "electron tests/menu-audit.browser.cjs",
    "test:recovery-ui": "electron tests/update-recovery.browser.cjs",
    "test:data-ui": "electron tests/data-safety.browser.cjs",
    "release:check": "node build/release-check.cjs",
    "build:compliance": "node build/prepare-compliance.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "prismjs": "1.30.0"
  },
  "productName": "ATLAS",
  "build": {
    "appId": "com.springycape.atlas",
    "productName": "ATLAS",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "**/*",
      "!tests/**",
      "!README.md",
      "!Setup-ATLAS.ps1",
      "!Start-ATLAS.cmd",
      "!install-desktop-runtime.cmd",
      "!build/**",
      "!docs/**",
      "!dist/**",
      "!speech/**",
      "!.setup-cache/**",
      "!ATLAS.lnk",
      "!.handover/**",
      "!.agents/**",
      "!.codex/**",
      "!.aws/**",
      "!.github/**",
      "!.env",
      "!.env.*",
      "!*.enc",
      "!legal/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/node-pty/build/**",
      "!node_modules/pdfjs-dist/standard_fonts/Liberation*.ttf",
      "!node_modules/pdfjs-dist/standard_fonts/LICENSE_LIBERATION"
    ],
    "extraResources": [
      {
        "from": "speech/whisper/Release",
        "to": "speech/whisper/Release",
        "filter": [
          "whisper-server.exe",
          "whisper.dll",
          "ggml.dll",
          "ggml-base.dll",
          "ggml-cpu.dll"
        ]
      },
      {
        "from": "speech/models",
        "to": "speech/models",
        "filter": [
          "ggml-tiny.en.bin",
          "ggml-small.en-q5_1.bin"
        ]
      },
      {
        "from": "dist/compliance",
        "to": "compliance"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ATLAS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ATLAS",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "springycape20",
        "repo": "atlas-desktop",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "beforePack": "build/prepare-compliance.cjs"
  },
  "license": "MIT",
  "author": "springycape20"
}
